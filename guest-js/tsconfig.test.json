{
   "compilerOptions": {
      "target": "ES2020",
      "module": "commonjs",
      "lib": ["ES2020", "DOM"],
      "outDir": "../.test-dist",
      "moduleResolution": "node",
      "esModuleInterop": true,
      "strict": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true
   },
   "include": [
      "envelope.ts",
      "envelope.test.ts",
      "subtitle-envelope.ts",
      "subtitle-envelope.test.ts",
      "subtitle-options.ts",
      "subtitle-options.test.ts",
      "index.ts",
      "thumbnail-options.ts",
      "thumbnail-options.test.ts"
   ]
}
